# TODO(you): ServiceAccount + Role for Postgres backup Jobs — TASKS.md §3
# Principle: least privilege. Backup needs pod exec / job create + secret read,
# not cluster-admin.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: pg-backup
  namespace: records
  labels:
    app.kubernetes.io/part-of: db-lab
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: pg-backup
  namespace: records
rules:
  # TODO(you): tighten these verbs/resources to what your Job actually needs
  - apiGroups: [""]
    resources: ["pods", "pods/exec", "pods/log", "secrets", "persistentvolumeclaims"]
    verbs: ["get", "list", "create"]
  - apiGroups: ["batch"]
    resources: ["jobs"]
    verbs: ["get", "list", "create", "delete"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: pg-backup
  namespace: records
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: pg-backup
subjects:
  - kind: ServiceAccount
    name: pg-backup
    namespace: records
