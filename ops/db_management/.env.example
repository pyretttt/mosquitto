# Copy to .env and adjust. Never commit real secrets.

CLUSTER_NAME=db-lab
NS_APP=records
NS_DB=records
APP_HELM_RELEASE=records-api
PG_HELM_RELEASE=records-pg
IMAGE_NAME=records-api
IMAGE_TAG=local

# Lab-only Postgres credentials (override locally).
POSTGRES_USER=records
POSTGRES_PASSWORD=lab-only-change-me
POSTGRES_DB=records

# Host used in the self-signed TLS cert / Ingress host
INGRESS_HOST=records.localtest.me
